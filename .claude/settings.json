{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.github/scripts/rider_lint.py hook --sln Tatehama_shukkindai.slnx",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.github/scripts/rider_lint.py hook --sln Tatehama_shukkindai.slnx",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.github/scripts/rider_lint.py hook --sln Tatehama_shukkindai.slnx",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
